# Copy to .env, or pass variables before docker compose commands.
SERVO_PORT=7443
SERVO_BIND_ADDRESS=127.0.0.1
SERVO_WEB_USER=servo
# Required: replace with your own password (12–128 UTF-8 bytes).
# First start only; use the viewer’s Account option for later changes.
# After startup: python3 scripts/web-credentials.py encrypt-env
# Single quotes preserve literal $, # and spaces in Compose .env files.
SERVO_WEB_PASSWORD='replace-with-a-unique-password'
# Host directory; the browser and authenticated viewer use this same folder.
SERVO_DOWNLOAD_DIR=./downloads
SERVO_RESOLUTION=1440x900
SERVO_START_URL=https://example.com/
SERVO_BUILD_PROFILE=release
SERVO_BUILD_JOBS=2
