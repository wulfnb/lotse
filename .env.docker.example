# Copy to .env, or pass variables before docker compose commands.
WEGA_PORT=7443
WEGA_BIND_ADDRESS=127.0.0.1
WEGA_WEB_USER=wega
# Required: replace with your own password (12–128 UTF-8 bytes).
# First start only; use the viewer’s Account option for later changes.
# After startup: python3 scripts/web-credentials.py encrypt-env
# Single quotes preserve literal $, # and spaces in Compose .env files.
WEGA_WEB_PASSWORD='replace-with-a-unique-password'
# Host directory; the browser and authenticated viewer use this same folder.
WEGA_DOWNLOAD_DIR=./downloads
WEGA_RESOLUTION=1280x800
WEGA_START_URL=https://example.com/
WEGA_BUILD_PROFILE=release
WEGA_BUILD_JOBS=2

# Optional: extra names/addresses for the generated certificate (comma list).
# WEGA_TLS_SANS=wega.home.arpa,192.168.1.20
# Optional: reverse proxies whose X-Forwarded-For is trusted (comma list of IPs/CIDRs).
# WEGA_TRUSTED_PROXIES=172.16.0.0/12
# Optional: extra plain-HTTP port for a TLS-terminating proxy on a trusted network.
# Never publish it; see docs/docker.md.
# WEGA_HTTP_PORT=7080
# Resource limits and tuning (defaults shown).
# WEGA_MEM_LIMIT=2g
# WEGA_CPUS=2
# WEGA_PIDS_LIMIT=512
# WEGA_SHM_SIZE=512mb
# WEGA_RENDER_THREADS=2
# WEGA_VNC_WAIT=50
# WEGA_UPLOAD_RETENTION_DAYS=7
# Build options: omit CJK fonts (~90 MB) or third-party notices generation.
# WEGA_CJK_FONTS=1
# WEGA_LICENSE_NOTICES=1
